/target
*.so
.DS_Store
*.log
__pycache__/
*.bak

# Benchmark data files (large parquet datasets)
benchmarks/data/*.parquet
# Atomic-write temp files (e.g. hits_sorted.parquet.tmp) left by an interrupted COPY
benchmarks/data/*.parquet.tmp
# DuckDB spill directory used by prepare_data.py's out-of-core sort
benchmarks/data/.duckdb_spill/
# Synthetic fixtures of the Top-K aggregate research (#386)
benchmarks/data/topk_agg/

# Benchmark run outputs (regenerated by bench scripts)
benchmarks/results.json
benchmarks/clickbench_results.json

# autoresearch generated results (flamegraphs, run summaries) and baseline/candidate/diff reports
benchmarks/autoresearch/results/
benchmarks/autoresearch/pilot/reports/
.opencode/
.claude/
build/

# local git worktrees (scratch)
.worktrees/
.vscode/
libltseq_core.dylib.dSYM/
docs/superpowers/

# Files the tutorial notebooks write next to themselves when run
tutorials/*/stock.csv
tutorials/*/access_log.csv
tutorials/*/access_log.parquet
.ipynb_checkpoints/
