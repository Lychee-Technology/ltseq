+/// Evidence switch (#296, PR #423; not shipped): the comma-separated names in `var`.
+fn spike_list(var: &str) -> Vec<String> {
+    std::env::var(var)
+        .map(|v| v.split(',').map(str::to_string).collect())
+        .unwrap_or_default()
+}
+
+/// Evidence switch (#296, PR #423; not shipped): `LTSEQ_SPIKE_UNGUARD=name,name`
+/// runs those DataFusion rules without their `rewrite_guard` guard.
+fn spike_unguarded(name: &str) -> bool {
+    spike_list("LTSEQ_SPIKE_UNGUARD").iter().any(|n| n == name)
+}
